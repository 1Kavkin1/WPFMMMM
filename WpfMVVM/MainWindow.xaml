<Window x:Class="WpfMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfMVVM"
        xmlns:conv="clr-namespace:WpfMVVM.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <!-- Конвертер URL -> зображення -->
        <conv:UrlToImageConverter x:Key="UrlToImage"/>
    </Window.Resources>

    <DockPanel Margin="10">

        <!-- Панель кнопок праворуч -->
        <StackPanel DockPanel.Dock="Right" Width="100">
            <Button Name="btnAddUser" Click="btnAddUser_Click">Додати</Button>
            <Button Name="btnEditUser" Margin="0 10 0 0">Редагувати</Button>
        </StackPanel>

        <!-- Таблиця користувачів -->
        <DataGrid Name="dgvUsers" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>

                <!-- Фото -->
                <DataGridTemplateColumn Header="Фото">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Image Width="50" Height="100"
                                   Source="{Binding Image, Converter={StaticResource UrlToImage}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Ім'я -->
                <DataGridTextColumn Header="Ім'я"
                                    Binding="{Binding Name}"
                                    MinWidth="200" MaxWidth="400"/>

                <!-- Телефон -->
                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding Phone}"
                                    MinWidth="150" MaxWidth="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
